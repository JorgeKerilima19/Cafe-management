generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders             Order[]
  voidRecords        VoidRecord[]
  cashRegisters      CashRegister[] @relation("OpenedRegisters")
  cashRegisterClosed CashRegister[] @relation("ClosedRegisters")
}

enum Role {
  ADMIN
  BARISTA
  STAFF
  SYSTEM
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  price       Float
  category    String   @default("General") @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?

  orderItems OrderItem[]
  recipe     Recipe? // ← NEW: Optional 1-to-1 recipe
}

/// ==========================================
/// RECIPES (NEW)
/// ==========================================

model Recipe {
  id         String   @id @default(cuid())
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantityRequired Float // Must match the inventory item's unit (kg, L, units)
  createdAt        DateTime @default(now())
}

/// ==========================================
/// ORDERS
/// ==========================================

model Order {
  id            String  @id @default(cuid())
  customerName  String?
  customerPhone String?

  total      Float
  cashAmount Float @default(0)
  yapeAmount Float @default(0)

  paymentMethod String
  status        OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  items       OrderItem[]
  voidRecords VoidRecord[]
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  menuItemId String

  name     String  @db.VarChar(255)
  price    Float
  quantity Int     @default(1)
  options  String?

  createdAt DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model PendingOrder {
  id            String   @id @default(cuid())
  customerName  String
  customerPhone String?
  items         Json
  total         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pending_orders")
}

model VoidRecord {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  amount    Float
  reason    String   @db.Text
  createdAt DateTime @default(now())
  voidedAt  DateTime

  voidedById String?
  voidedBy   User?   @relation(fields: [voidedById], references: [id])
}

model CashRegister {
  id             String    @id @default(cuid())
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingAmount  Float
  closingAmount  Float?
  expectedAmount Float?
  notes          String?   @db.Text
  isOpen         Boolean   @default(true)

  openedById String
  openedBy   User   @relation("OpenedRegisters", fields: [openedById], references: [id])

  closedById String?
  closedBy   User?   @relation("ClosedRegisters", fields: [closedById], references: [id])

  @@map("cash_registers")
}

model InventoryItem {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  quantity  Float
  unit      String   @db.VarChar(50)
  category  String?  @db.VarChar(100)
  threshold Float    @default(0)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeIngredients RecipeIngredient[] // ← NEW: Reverse relation

  @@map("inventory_items")
}

model DayExpense {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  cost      Float
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("day_expenses")
}
