generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // bcrypt hashed
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  voidRecords VoidRecord[]

  cashRegisters CashRegister[] @relation("OpenedRegisters")

  cashRegisterClosed CashRegister[] @relation("ClosedRegisters")
}

enum Role {
  ADMIN
  BARISTA
  STAFF
  SYSTEM
}

/// ========================
/// MENU ITEMS
/// ========================

model MenuItem {
  id          String   @id @default(cuid( ))
  name        String   @db.VarChar(255)
  description String?  @db.Text
  price       Float
  category    String   @default("General") @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?

  orderItems OrderItem[]
}

/// ========================
/// ORDERS
/// ========================

  model Order {
    id            String  @id @default(cuid())
    customerName  String? // e.g., "Mesa 3" or "Ana"
    customerPhone String? // for Yape reference

    total      Float
    cashAmount Float @default(0)
    yapeAmount Float @default(0)

    paymentMethod String // "CASH" | "YAPE" | "MIXED"
    status        OrderStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Optional: staff who marked as paid/prepared
    userId String?
    user   User?   @relation(fields: [userId], references: [id])

    items OrderItem[]

    voidRecords VoidRecord[]
  }

  enum OrderStatus {
    PENDING
    PAID
    PREPARING
    READY
    COMPLETED
    CANCELLED
  }

  /// ========================
  /// ORDER ITEMS (for item-level reporting)
  /// ========================

  model OrderItem {
    id         String @id @default(cuid())
    orderId    String
    menuItemId String

    name     String  @db.VarChar(255)
    price    Float
    quantity Int     @default(1)
    options  String?

    createdAt DateTime @default(now())

    order    Order    @relation(fields: [orderId], references: [id])
    menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  }

  model PendingOrder {
    id            String   @id @default(cuid())
    customerName  String
    customerPhone String?
    items         Json // Array of { id, name, price, quantity }
    total         Float
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    // Optional: auto-delete old carts
    @@map("pending_orders")
  }

model VoidRecord {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  amount    Float
  reason    String   @db.Text
  createdAt DateTime @default(now())
  voidedAt  DateTime

  // ✅ Make these OPTIONAL
  voidedById String? // ← ? makes it nullable
  voidedBy   User?   @relation(fields: [voidedById], references: [id]) // ← ? makes relation optional
}

model CashRegister {
  id             String    @id @default(cuid())
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingAmount  Float // Amount left as safeguard
  closingAmount  Float? // Final cash count
  expectedAmount Float? // Calculated sales (cash only)
  notes          String?   @db.Text
  isOpen         Boolean   @default(true)

  // Staff who opened/closed
  openedById String
  openedBy   User   @relation("OpenedRegisters", fields: [openedById], references: [id])

  closedById String? // Optional if not closed yet
  closedBy   User?   @relation("ClosedRegisters", fields: [closedById], references: [id])

  @@map("cash_registers")
}

model InventoryItem {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  quantity  Float // Supports decimals (e.g., 2.5 kg)
  unit      String   @db.VarChar(50) // kg, units, liters, etc.
  category  String?  @db.VarChar(100) // Coffee, Milk, Cups, etc.
  threshold Float    @default(0) // Alert when stock < this
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}
